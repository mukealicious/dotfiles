#!/bin/sh
# shellcheck disable=SC1091,SC2088,SC2153,SC2154
#
# dot-doctor — environment diagnostics for dotfiles
#
# Validates that the dotfiles system is healthy:
#   - Critical CLIs are installed
#   - Top-level *.symlink files are linked to ~/
#   - Fish shell config is properly symlinked
#   - Herdr is installed for agent multiplexing
#   - Tool configs (starship, ripgrep) are linked
#   - PATH includes expected directories
#   - Fish is registered as login shell
#   - AI instruction files, skills, and agents are assembled
#
# Exit codes:
#   0 — all checks passed (warnings are OK)
#   1 — one or more failures detected
#
# Adding new checks:
#   Follow the section pattern: header "Section Name", then
#   pass/warn/fail calls. Use check_symlink for symlink validation.

set -e

DOTFILES_ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
NPM_MIN_RELEASE_AGE="7"
NI_DEFAULT_AGENT="defaultAgent=pnpm"
PNPM_MIN_RELEASE_AGE="minimumReleaseAge: 10080"
PNPM_STRICT_RELEASE_AGE="minimumReleaseAgeStrict: true"
PNPM_TRUST_POLICY="trustPolicy: no-downgrade"
UV_EXCLUDE_NEWER='exclude-newer = "P7D"'
BUN_MIN_RELEASE_AGE='minimumReleaseAge = 604800'

# Shared helpers (pass, warn, fail, info, header, check_symlink)
# shellcheck source=../lib/symlink.sh
. "$DOTFILES_ROOT/lib/symlink.sh"

check_file_contains_literal() {
  target="$1"
  expected="$2"
  desc="$3"

  if [ ! -f "$target" ]; then
    fail "$desc is missing"
    info "Expected file: $target"
    info "Fix: dot"
    return
  fi

  if grep -Fq "$expected" "$target" 2>/dev/null; then
    pass "$desc"
  else
    fail "$desc is not set"
    info "Expected: $expected"
    info "Fix: update dotfiles config and run dot"
  fi
}

mise_tool_version() {
  tool="$1"
  command -v mise >/dev/null 2>&1 || return 1
  mise current -C "$DOTFILES_ROOT" "$tool" 2>/dev/null
}

check_mise_tool_selected() {
  tool="$1"
  actual="$(command -v "$tool" 2>/dev/null || true)"
  expected="$(mise which "$tool" 2>/dev/null || true)"
  shim="$HOME/.local/share/mise/shims/$tool"

  if [ -z "$actual" ] || [ -z "$expected" ]; then
    fail "$tool is not available through mise"
    info "Fix: run $DOTFILES_ROOT/mise/install.sh and open a new shell"
  elif [ "$actual" = "$expected" ] || [ "$actual" = "$shim" ]; then
    pass "$tool resolves through mise: $actual"
  else
    fail "$tool bypasses mise: $actual"
    info "Expected: $expected"
    info "Fix: run dot, then open a new shell"
  fi
}

check_dotfiles_command() {
  command_name="$1"
  actual="$(command -v "$command_name" 2>/dev/null || true)"
  expected="$DOTFILES_ROOT/bin/$command_name"

  if [ "$actual" = "$expected" ]; then
    pass "$command_name runtime wrapper: $actual"
  else
    fail "$command_name bypasses its dotfiles runtime wrapper: ${actual:-missing}"
    info "Expected: $expected"
    info "Fix: run dot, then open a new shell"
  fi
}

# ── Critical CLIs ──────────────────────────────────────────────

header "Critical CLIs"

for cmd in brew fish herdr starship mise node pnpm bun ni yarn uv qmd portless; do
  if command -v "$cmd" >/dev/null 2>&1; then
    pass "$cmd"
  else
    fail "$cmd not found"
  fi
done

if command -v mise >/dev/null 2>&1; then
  check_mise_tool_selected node
  check_mise_tool_selected pnpm
  check_mise_tool_selected bun
fi

check_dotfiles_command ni
check_dotfiles_command yarn

if command -v qmd >/dev/null 2>&1; then
  qmd_path="$(command -v qmd)"
  expected_qmd_wrapper="$DOTFILES_ROOT/bin/qmd"
  node_version="$(mise_tool_version node || true)"
  mise_qmd_bin=""
  if command -v mise >/dev/null 2>&1 && [ -n "$node_version" ]; then
    mise_prefix="$(mise exec -C "$DOTFILES_ROOT" "node@$node_version" -- npm prefix -g 2>/dev/null || true)"
    if [ -n "$mise_prefix" ]; then
      mise_qmd_bin="$mise_prefix/bin/qmd"
    fi
  fi

  case "$qmd_path" in
    "$expected_qmd_wrapper")
      pass "qmd runtime path: $qmd_path (dotfiles wrapper)"
      ;;
    "$HOME/.bun/"*)
      warn "qmd resolves from Bun global packages"
      info "Native deps like better-sqlite3 are more stable under mise-managed Node"
      info "Fix: run dot and ensure $DOTFILES_ROOT/bin precedes Bun and mise runtime bins on PATH"
      ;;
    "$mise_qmd_bin")
      warn "qmd resolves directly to the mise Node binary, bypassing the dotfiles wrapper"
      info "Per-project .qmd auto-detection in Bash/Zsh/Pi requires: $expected_qmd_wrapper"
      info "Fix: run dot, open a new shell, and ensure $DOTFILES_ROOT/bin precedes mise runtime bins on PATH"
      ;;
    *)
      warn "qmd resolves from unexpected path: $qmd_path"
      info "Expected wrapper: $expected_qmd_wrapper"
      ;;
  esac

  if [ -n "$mise_qmd_bin" ] && [ -x "$mise_qmd_bin" ]; then
    pass "qmd mise runtime binary: $mise_qmd_bin"
  else
    warn "qmd is not installed under the mise-managed Node runtime"
    info "Fix: run $DOTFILES_ROOT/mise/install.sh"
  fi

  if [ -x "$expected_qmd_wrapper" ] && "$expected_qmd_wrapper" --version >/dev/null 2>&1; then
    pass "qmd wrapper executes"
  else
    warn "qmd wrapper does not execute cleanly"
    info "Fix: run $DOTFILES_ROOT/mise/install.sh"
  fi

  if qmd --version >/dev/null 2>&1; then
    pass "qmd command executes"
  else
    warn "qmd command does not execute cleanly"
    info "Fix: dot, then rerun mise/install.sh to rebuild QMD under the pinned Node runtime"
  fi
fi

if command -v parallel-cli >/dev/null 2>&1 && parallel-cli --version >/dev/null 2>&1; then
  pass "parallel-cli"
else
  warn "parallel-cli not ready"
  info "Needed by the Pi researcher agent via pi-parallel"
  info "Install via upstream script: curl -fsSL https://parallel.ai/install.sh | bash"
  info "Then authenticate: parallel-cli login"
fi

if command -v ffmpeg >/dev/null 2>&1; then
  pass "ffmpeg"
else
  warn "ffmpeg not found"
  info "Used by TTS and media processing workflows"
  info "Install: brew install ffmpeg"
fi

if command -v yt-dlp >/dev/null 2>&1; then
  pass "yt-dlp"
else
  warn "yt-dlp not found"
  info "Used by media-capable reading helpers and agent workflows"
  info "Install: brew install yt-dlp"
fi

if command -v parakeet-mlx >/dev/null 2>&1; then
  pass "parakeet-mlx"
else
  warn "parakeet-mlx not found"
  info "Used by the moja-glava YouTube transcription adapter"
  info "Install: $DOTFILES_ROOT/python/install.sh"
fi

# ── Apple Reminders ────────────────────────────────────────────

header "Apple Reminders"

if [ "$(uname -s)" != "Darwin" ]; then
  warn "RemCTL is macOS-only"
elif ! command -v remctl >/dev/null 2>&1; then
  fail "remctl not found"
  info "Fix: $DOTFILES_ROOT/remctl/install.sh"
else
  # shellcheck source=../remctl/version.env
  . "$DOTFILES_ROOT/remctl/version.env"
  remctl_path="$(command -v remctl)"
  remctl_version="$(remctl --version 2>/dev/null || true)"

  if [ "$remctl_path" = "$HOME/.local/bin/remctl" ]; then
    pass "remctl runtime path: $remctl_path"
  else
    fail "remctl resolves from an unexpected path: $remctl_path"
    info "Expected: $HOME/.local/bin/remctl"
    info "Fix: ensure ~/.local/bin precedes other RemCTL installs on PATH"
  fi

  if [ "$remctl_version" = "$REMCTL_VERSION" ]; then
    pass "remctl version: $remctl_version"
  else
    fail "remctl version is ${remctl_version:-unknown}; expected $REMCTL_VERSION"
    info "Fix: $DOTFILES_ROOT/remctl/install.sh"
  fi

  remctl_python="$(uv python find '>=3.10' 2>/dev/null || true)"
  if [ -n "$remctl_python" ] && [ "$(head -n 1 "$HOME/.local/bin/remctl" 2>/dev/null || true)" = "#!$remctl_python" ]; then
    pass "remctl uv Python runtime: $remctl_python"
  else
    fail "remctl is not pinned to the expected uv Python 3.10+ runtime"
    info "Fix: $DOTFILES_ROOT/remctl/install.sh"
  fi

  if [ -x "$HOME/.local/bin/remctl-bridge" ]; then
    pass "remctl EventKit bridge"
  else
    fail "remctl EventKit bridge is missing"
    info "Fix: $DOTFILES_ROOT/remctl/install.sh"
  fi

  if [ -x "$HOME/.local/bin/remctl-private" ]; then
    pass "remctl private metadata helper"
  else
    warn "remctl private metadata helper is missing"
    info "Private ReminderKit writes will be unavailable; rerun $DOTFILES_ROOT/remctl/install.sh"
  fi

  if [ -x "$HOME/.local/bin/remctl-permissions" ]; then
    pass "remctl permission helper"
  else
    warn "remctl guided permission helper is missing"
    info "Fix: $DOTFILES_ROOT/remctl/install.sh"
  fi

  if [ -f "$HOME/.config/fish/completions/remctl.fish" ]; then
    pass "remctl Fish completion"
  else
    warn "remctl Fish completion is missing"
    info "Fix: $DOTFILES_ROOT/remctl/install.sh"
  fi

  info "Reminders permissions are host-scoped; verify when needed with: remctl doctor --for-agent --json"
fi

# ── Surf browser lanes ─────────────────────────────────────────

header "Surf browser lanes"

for wrapper in surf surf-brave surf-edge; do
  if [ -x "$DOTFILES_ROOT/bin/$wrapper" ]; then
    pass "$wrapper wrapper"
  else
    fail "$wrapper wrapper missing"
    info "Fix: restore $DOTFILES_ROOT/bin/$wrapper"
  fi
done

surf_node_version="$(mise_tool_version node || true)"
surf_mise_bin=""
if command -v mise >/dev/null 2>&1 && [ -n "$surf_node_version" ]; then
  surf_mise_prefix="$(mise exec -C "$DOTFILES_ROOT" "node@$surf_node_version" -- npm prefix -g 2>/dev/null || true)"
  if [ -n "$surf_mise_prefix" ]; then
    surf_mise_bin="$surf_mise_prefix/bin/surf"
  fi
fi

if [ -n "$surf_mise_bin" ] && [ -x "$surf_mise_bin" ]; then
  pass "surf-cli mise runtime binary: $surf_mise_bin"
else
  warn "surf-cli is not installed under the mise-managed Node runtime"
  info "Fix: run $DOTFILES_ROOT/mise/install.sh"
fi

check_surf_manifest() {
  lane_label="$1"
  manifest_path="$2"
  expected_socket="$3"

  if [ ! -f "$manifest_path" ]; then
    warn "$lane_label Surf native host manifest not installed"
    info "Fix: load Surf extension in $lane_label, then run $DOTFILES_ROOT/surf/install.sh"
    return
  fi

  if ! command -v jq >/dev/null 2>&1; then
    warn "$lane_label Surf native host manifest could not be validated (jq missing)"
    return
  fi

  if ! jq -e '
    .name == "surf.browser.host" and
    .type == "stdio" and
    (.path | type == "string" and length > 0) and
    (.allowed_origins | type == "array" and length > 0 and all(.[]; test("^chrome-extension://[a-p]{32}/$")))
  ' "$manifest_path" >/dev/null 2>&1; then
    fail "$lane_label Surf native host manifest is invalid"
    info "Fix: rerun $DOTFILES_ROOT/surf/install.sh"
    return
  fi

  pass "$lane_label Surf native host manifest"

  surf_host_wrapper="$(jq -r '.path' "$manifest_path")"
  if [ -x "$surf_host_wrapper" ]; then
    pass "$lane_label Surf native host wrapper"
  else
    fail "$lane_label Surf native host wrapper is missing or not executable"
    info "Expected wrapper: $surf_host_wrapper"
    info "Fix: rerun $DOTFILES_ROOT/surf/install.sh"
    return
  fi

  if grep -Fq "SURF_SOCKET=\"$expected_socket\"" "$surf_host_wrapper"; then
    pass "$lane_label Surf socket configuration"
  else
    fail "$lane_label Surf native host does not target $expected_socket"
    info "Fix: rerun $DOTFILES_ROOT/surf/install.sh"
  fi

  if [ ! -S "$expected_socket" ]; then
    warn "$lane_label Surf runtime is not ready (socket absent: $expected_socket)"
    info "Open $lane_label with the Surf extension enabled, then rerun dot doctor"
  elif mise exec -C "$DOTFILES_ROOT" "node@$surf_node_version" -- node -e '
    const net = require("node:net");
    const socket = net.createConnection(process.argv[1]);
    const done = (status) => { socket.destroy(); process.exit(status); };
    socket.setTimeout(250, () => done(1));
    socket.once("connect", () => done(0));
    socket.once("error", () => done(1));
  ' "$expected_socket" >/dev/null 2>&1; then
    pass "$lane_label Surf runtime socket"
  else
    fail "$lane_label Surf runtime socket exists but is not accepting connections"
    info "Restart $lane_label with the Surf extension enabled, then rerun dot doctor"
  fi
}

case "$(uname -s)" in
  Darwin)
    if [ -x "/Applications/Brave Browser Beta.app/Contents/MacOS/Brave Browser Beta" ]; then
      pass "Brave Browser Beta dedicated Surf app"
    else
      fail "Brave Browser Beta dedicated Surf app missing"
      info "Fix: brew install --cask brave-browser@beta"
    fi
    check_surf_manifest "Brave Beta" "$HOME/Library/Application Support/Google/Chrome/NativeMessagingHosts/surf.browser.host.json" "/tmp/surf-brave.sock"
    check_surf_manifest "Microsoft Edge" "$HOME/Library/Application Support/Microsoft Edge/NativeMessagingHosts/surf.browser.host.json" "/tmp/surf-edge.sock"
    ;;
  Linux)
    check_surf_manifest "Brave" "$HOME/.config/BraveSoftware/Brave-Browser/NativeMessagingHosts/surf.browser.host.json" "/tmp/surf-brave.sock"
    check_surf_manifest "Microsoft Edge" "$HOME/.config/microsoft-edge/NativeMessagingHosts/surf.browser.host.json" "/tmp/surf-edge.sock"
    ;;
  *)
    warn "Surf lane manifest checks are only implemented for macOS and Linux"
    ;;
esac

# ── Top-level symlinks ─────────────────────────────────────────

header "Top-level symlinks"

for src in "$DOTFILES_ROOT"/*/*.symlink; do
  [ -e "$src" ] || continue
  name="$(basename "${src%.*}")"
  check_symlink "$src" "$HOME/.$name" "~/.$name"
done

# ── Fish config ────────────────────────────────────────────────

header "Fish config"

FISH_SRC="$DOTFILES_ROOT/fish"
FISH_DEST="$HOME/.config/fish"

check_symlink "$FISH_SRC/config.fish" "$FISH_DEST/config.fish" "config.fish"

# conf.d files from fish/conf.d/
for file in "$FISH_SRC/conf.d"/*.fish; do
  [ -e "$file" ] || continue
  name="$(basename "$file")"
  check_symlink "$file" "$FISH_DEST/conf.d/$name" "conf.d/$name"
done

# Topic aliases
for file in "$DOTFILES_ROOT"/*/aliases.fish; do
  [ -e "$file" ] || continue
  topic="$(basename "$(dirname "$file")")"
  check_symlink "$file" "$FISH_DEST/conf.d/${topic}-aliases.fish" "conf.d/${topic}-aliases.fish"
done

# Topic keybindings
for file in "$DOTFILES_ROOT"/*/keybindings.fish; do
  [ -e "$file" ] || continue
  topic="$(basename "$(dirname "$file")")"
  check_symlink "$file" "$FISH_DEST/conf.d/${topic}-keybindings.fish" "conf.d/${topic}-keybindings.fish"
done

# Functions
for file in "$FISH_SRC/functions"/*.fish; do
  [ -e "$file" ] || continue
  name="$(basename "$file")"
  check_symlink "$file" "$FISH_DEST/functions/$name" "functions/$name"
done

# Completions
for file in "$FISH_SRC/completions"/*.fish; do
  [ -e "$file" ] || continue
  name="$(basename "$file")"
  check_symlink "$file" "$FISH_DEST/completions/$name" "completions/$name"
done

# ── Herdr ──────────────────────────────────────────────────────

header "Herdr"

if command -v herdr >/dev/null 2>&1; then
  pass "herdr installed"
  if herdr --version >/dev/null 2>&1; then
    pass "herdr command executes"
  else
    warn "herdr command does not execute cleanly"
  fi
  check_symlink "$DOTFILES_ROOT/herdr/config.toml" "$HOME/.config/herdr/config.toml" "Herdr config.toml"
  if HERDR_CONFIG_PATH="$DOTFILES_ROOT/herdr/config.toml" herdr config check >/dev/null 2>&1; then
    pass "Herdr source config validates"
  else
    fail "Herdr source config is invalid"
    info "Fix: update $DOTFILES_ROOT/herdr/config.toml"
  fi
  herdr_status="$(herdr status 2>/dev/null || true)"
  if printf '%s\n' "$herdr_status" | grep -q 'restart_needed: yes'; then
    warn "running Herdr server is older than the installed client"
    info "Homebrew upgrades cannot live-handoff Herdr sessions"
    info "Checkpoint important work, then from outside Herdr run: herdr server stop; herdr"
    info "Stopping the server exits its pane processes"
  elif printf '%s\n' "$herdr_status" | grep -q 'restart_needed: no'; then
    pass "running Herdr server matches installed client"
  fi

  if herdr --skill >/dev/null 2>&1; then
    pass "Herdr release-matched agent skill is available"
  else
    warn "Herdr does not expose its release-matched agent skill"
    info "Expected on Herdr 0.8+: herdr --skill"
  fi

  integration_issues=0
  personal_integrations="$(PI_CODING_AGENT_DIR="$HOME/.pi/personal" herdr integration status 2>/dev/null || true)"
  work_integrations="$(PI_CODING_AGENT_DIR="$HOME/.pi/work" herdr integration status 2>/dev/null || true)"

  if [ ! -d "$HOME/.pi/personal" ]; then
    fail "required Pi personal profile is missing"
    integration_issues=1
  elif ! printf '%s\n' "$personal_integrations" | grep -q '^pi: current '; then
    warn "Herdr Pi personal integration is missing or outdated"
    integration_issues=1
  fi
  if [ ! -d "$HOME/.pi/work" ]; then
    fail "required Pi work profile is missing"
    integration_issues=1
  elif ! printf '%s\n' "$work_integrations" | grep -q '^pi: current '; then
    warn "Herdr Pi work integration is missing or outdated"
    integration_issues=1
  fi

  for integration in claude codex opencode; do
    if command -v "$integration" >/dev/null 2>&1 \
      && ! printf '%s\n' "$personal_integrations" | grep -q "^$integration: current "; then
      warn "Herdr $integration integration is missing or outdated"
      integration_issues=1
    fi
  done

  if [ "$integration_issues" -eq 0 ]; then
    pass "Herdr agent integrations are installed and current"
  else
    info "Fix: $DOTFILES_ROOT/herdr/install.sh"
  fi
else
  warn "herdr not found"
  info "Install: brew install herdr"
fi

# ── Hammerspoon ────────────────────────────────────────────────

header "Hammerspoon"

if [ -d "/Applications/Hammerspoon.app" ]; then
  pass "Hammerspoon app"
else
  fail "Hammerspoon app is not installed"
  info "Fix: brew bundle --file $DOTFILES_ROOT/Brewfile"
fi

check_symlink "$DOTFILES_ROOT/hammerspoon/init.lua" "$HOME/.hammerspoon/init.lua" "Hammerspoon init.lua"
check_symlink "$DOTFILES_ROOT/hammerspoon/lib" "$HOME/.hammerspoon/lib" "Hammerspoon lib"
check_symlink "$DOTFILES_ROOT/hammerspoon/bin" "$HOME/.hammerspoon/bin" "Hammerspoon bin"

if [ -x "$DOTFILES_ROOT/hammerspoon/bin/start-agent.sh" ] \
  && [ -x "$DOTFILES_ROOT/hammerspoon/bin/wait-for-agent.sh" ]; then
  pass "Hammerspoon agent launcher"
else
  fail "Hammerspoon agent launcher or queue waiter is not executable"
  info "Fix: $DOTFILES_ROOT/hammerspoon/install.sh"
fi

capture_dependencies_ok=true
for command in herdr hunk jq; do
  if ! command -v "$command" >/dev/null 2>&1; then
    fail "Hammerspoon capture dependency is missing: $command"
    capture_dependencies_ok=false
  fi
done
if [ "$capture_dependencies_ok" = true ]; then
  pass "Hammerspoon capture dependencies"
fi

if [ -x "$DOTFILES_ROOT/bin/pi-personal" ]; then
  if "$DOTFILES_ROOT/bin/pi-personal" --version >/dev/null 2>&1; then
    pass "Hammerspoon personal Pi launcher"
  else
    fail "Hammerspoon personal Pi launcher cannot start"
    info "Check the mise-managed Node and Pi installation"
  fi
else
  fail "Hammerspoon personal Pi launcher is missing"
fi

if [ -x "$DOTFILES_ROOT/bin/pi-profile-check" ]; then
  pass "Pi profile-boundary evidence checker"
else
  fail "Pi profile-boundary evidence checker is missing"
  info "Expected: $DOTFILES_ROOT/bin/pi-profile-check"
fi

moja_glava_dir="${MOJA_GLAVA_DIR:-$HOME/Code/moja-glava}"
if [ -d "$moja_glava_dir" ] && [ -f "$moja_glava_dir/AGENTS.md" ]; then
  pass "Hammerspoon Moja Glava vault"
else
  fail "Hammerspoon Moja Glava vault or AGENTS.md is missing"
  info "Expected: $moja_glava_dir"
fi

if [ -f "$DOTFILES_ROOT/.ai-runtime/pi/skills/moja-glava/SKILL.md" ]; then
  pass "Hammerspoon moja-glava skill projection"
else
  fail "Hammerspoon moja-glava skill projection is missing"
  info "Fix: $DOTFILES_ROOT/ai/install.sh"
fi

hammerspoon_cli="/Applications/Hammerspoon.app/Contents/Frameworks/hs/hs"
if [ -x "$hammerspoon_cli" ]; then
  if hammerspoon_runtime="$("$hammerspoon_cli" -t 2 -q -c '
    local palette = _G.desktopAgentPalette
    local queue = palette and palette.writerQueueStatus and palette:writerQueueStatus() or nil
    return hs.json.encode({
      palette_loaded = palette ~= nil,
      accessibility = hs.accessibilityState(false),
      screen_recording = hs.screenRecordingState(false),
      queue = queue,
    })
  ' 2>/dev/null)"; then
    pass "Hammerspoon runtime IPC"

    if printf '%s\n' "$hammerspoon_runtime" | jq -e '.palette_loaded == true' >/dev/null 2>&1; then
      pass "Hammerspoon desktop capture palette is loaded"
    else
      fail "Hammerspoon desktop capture palette is not loaded"
      info "Open the Hammerspoon Console, fix config errors, then reload while the capture queue is idle"
    fi

    if printf '%s\n' "$hammerspoon_runtime" | jq -e '.accessibility == true' >/dev/null 2>&1; then
      pass "Hammerspoon Accessibility permission"
    else
      fail "Hammerspoon Accessibility permission is missing"
      info "Enable Hammerspoon in System Settings → Privacy & Security → Accessibility"
    fi

    if printf '%s\n' "$hammerspoon_runtime" | jq -e '.screen_recording == true' >/dev/null 2>&1; then
      pass "Hammerspoon Screen Recording permission"
    else
      warn "Hammerspoon Screen Recording permission is missing"
      info "Text and metadata capture work, but screenshots require System Settings → Privacy & Security → Screen Recording"
    fi

    hammerspoon_queue="$(printf '%s\n' "$hammerspoon_runtime" | jq -c '.queue // {}' 2>/dev/null || true)"
    if printf '%s\n' "$hammerspoon_queue" | jq -e '.paused == true' >/dev/null 2>&1; then
      warn "Hammerspoon writer queue is paused"
      info "Reconcile its active Herdr tab before running: _G.desktopAgentPalette:resumeWriterQueue(true)"
      info "Queue state: $hammerspoon_queue"
    elif printf '%s\n' "$hammerspoon_queue" | jq -e '.idle == true' >/dev/null 2>&1; then
      pass "Hammerspoon writer queue is idle"
    else
      info "Hammerspoon writer queue is active: $hammerspoon_queue"
    fi
  else
    warn "Hammerspoon runtime is not available"
    info "Open Hammerspoon to enable the desktop capture hotkey and live permission checks"
  fi
fi

# ── Tool configs ───────────────────────────────────────────────

header "Tool configs"

check_symlink "$DOTFILES_ROOT/starship/starship.toml" "$HOME/.config/starship.toml" "starship.toml"
check_symlink "$DOTFILES_ROOT/mise/config.toml" "$HOME/.config/mise/config.toml" "mise/config.toml"
check_symlink "$DOTFILES_ROOT/mise.lock" "$HOME/.config/mise/mise.lock" "mise.lock"

if [ -n "${XDG_CONFIG_HOME:-}" ]; then
  PNPM_CONFIG="$XDG_CONFIG_HOME/pnpm/config.yaml"
else
  case "$(uname -s)" in
    Darwin)
      PNPM_CONFIG="$HOME/Library/Preferences/pnpm/config.yaml"
      ;;
    Linux)
      PNPM_CONFIG="$HOME/.config/pnpm/config.yaml"
      ;;
    *)
      PNPM_CONFIG=""
      ;;
  esac
fi

if [ -n "$PNPM_CONFIG" ]; then
  check_symlink "$DOTFILES_ROOT/pnpm/config.yaml" "$PNPM_CONFIG" "pnpm config.yaml"
fi

if [ -e "$HOME/.tool-versions" ]; then
  warn "legacy ~/.tool-versions exists"
  info "mise supports it, but this dotfiles setup now uses ~/.config/mise/config.toml"
fi

if [ -d "$DOTFILES_ROOT/ripgrep" ]; then
  check_symlink "$DOTFILES_ROOT/ripgrep/config" "$HOME/.config/ripgrep/config" "ripgrep/config"
fi

# ── Supply chain protections ────────────────────────────────────

header "Supply chain protections"

check_symlink "$DOTFILES_ROOT/python/uv.toml" "$HOME/.config/uv/uv.toml" "uv/uv.toml"
check_file_contains_literal "$HOME/.nirc" "$NI_DEFAULT_AGENT" "~/.nirc pnpm default"
check_file_contains_literal "$HOME/.npmrc" "min-release-age=$NPM_MIN_RELEASE_AGE" "~/.npmrc min-release-age"
if [ -n "$PNPM_CONFIG" ]; then
  check_file_contains_literal "$PNPM_CONFIG" "$PNPM_MIN_RELEASE_AGE" "pnpm config minimumReleaseAge"
  check_file_contains_literal "$PNPM_CONFIG" "$PNPM_STRICT_RELEASE_AGE" "pnpm config strict release age"
  check_file_contains_literal "$PNPM_CONFIG" "$PNPM_TRUST_POLICY" "pnpm config trust policy"
fi
check_file_contains_literal "$HOME/.config/uv/uv.toml" "$UV_EXCLUDE_NEWER" "~/.config/uv/uv.toml exclude-newer"
check_file_contains_literal "$HOME/.bunfig.toml" "$BUN_MIN_RELEASE_AGE" "~/.bunfig.toml minimumReleaseAge"

# ── PATH ───────────────────────────────────────────────────────

header "PATH"

for dir in "$HOME/.dotfiles/bin" "$HOME/.bun/bin" "$HOME/.local/bin"; do
  case ":$PATH:" in
    *":$dir:"*)
      pass "$dir in PATH"
      ;;
    *)
      warn "$dir not in PATH"
      ;;
  esac
done

# ── Shell registration ─────────────────────────────────────────

header "Shell registration"

FISH_PATH=""
if [ -f "/opt/homebrew/bin/fish" ]; then
  FISH_PATH="/opt/homebrew/bin/fish"
elif [ -f "/usr/local/bin/fish" ]; then
  FISH_PATH="/usr/local/bin/fish"
fi

if [ -n "$FISH_PATH" ]; then
  if grep -q "^$FISH_PATH$" /etc/shells 2>/dev/null; then
    pass "Fish in /etc/shells"
  else
    warn "Fish not in /etc/shells"
    info "Fix: echo '$FISH_PATH' | sudo tee -a /etc/shells"
  fi

  LOGIN_SHELL="$SHELL"
  if [ "$(uname -s)" = "Darwin" ] && command -v dscl >/dev/null 2>&1; then
    DSCL_LOGIN_SHELL="$(dscl . -read /Users/"${USER:-$(id -un)}" UserShell 2>/dev/null | awk '{print $2}')"
    if [ -n "$DSCL_LOGIN_SHELL" ]; then
      LOGIN_SHELL="$DSCL_LOGIN_SHELL"
    fi
  fi

  if [ "$LOGIN_SHELL" = "$FISH_PATH" ]; then
    pass "Fish is default shell"
  else
    warn "Default shell is $LOGIN_SHELL (not Fish)"
    info "Fix: chsh -s $FISH_PATH"
  fi
else
  warn "Fish binary not found"
fi

# ── AI instruction files ───────────────────────────────────────

header "AI instruction files"

MANAGED_MARKER='<!-- Managed by ~/.dotfiles/ai/install.sh. Edit source files instead. -->'

check_managed_file() {
  target="$1"
  desc="$2"

  if [ -f "$target" ]; then
    if grep -Fq "$MANAGED_MARKER" "$target" 2>/dev/null; then
      pass "$desc"
    else
      warn "$desc exists but is not installer-managed"
      info "May have been manually edited"
    fi
  else
    warn "$desc is missing"
    info "Fix: dot"
  fi
}

check_managed_file "$HOME/.claude/CLAUDE.md" "~/.claude/CLAUDE.md"
PI_RUNTIME_ROOT="$DOTFILES_ROOT/.ai-runtime/pi"
check_managed_file "$PI_RUNTIME_ROOT/AGENTS.md" ".ai-runtime/pi/AGENTS.md"
for profile in work personal; do
  profile_dir="$HOME/.pi/$profile"
  if [ -d "$profile_dir" ]; then
    check_symlink "$PI_RUNTIME_ROOT/AGENTS.md" "$profile_dir/AGENTS.md" "~/.pi/$profile/AGENTS.md"
  fi
done
check_managed_file "$HOME/.config/opencode/AGENTS.md" "~/.config/opencode/AGENTS.md"
check_managed_file "$HOME/.gemini/GEMINI.md" "~/.gemini/GEMINI.md"
check_managed_file "$HOME/.codex/instructions.md" "~/.codex/instructions.md"

# ── AI skill projections ───────────────────────────────────────

header "AI skill projections"

SHARED_SKILLS_SRC="$DOTFILES_ROOT/ai/skills"
CLAUDE_SKILLS_SRC="$DOTFILES_ROOT/claude/skills"
CLAUDE_DIR="$HOME/.claude"
PROJECTED_SKILLS_ROOT="$DOTFILES_ROOT/.ai-runtime"
PROJECTED_CLAUDE_SKILLS="$PROJECTED_SKILLS_ROOT/claude-code/skills"
PROJECTED_CODEX_SKILLS="$PROJECTED_SKILLS_ROOT/codex/skills"

check_projected_claude_skill() {
  skill_name="$1"

  if [ -d "$CLAUDE_SKILLS_SRC/$skill_name" ]; then
    check_symlink "$CLAUDE_SKILLS_SRC/$skill_name" "$CLAUDE_DIR/skills/$skill_name" "skills/$skill_name (overlay)"
  elif [ -d "$PROJECTED_CLAUDE_SKILLS/$skill_name" ]; then
    check_symlink "$PROJECTED_CLAUDE_SKILLS/$skill_name" "$CLAUDE_DIR/skills/$skill_name" "skills/$skill_name (shared)"
  fi
}

# Validate the effective winner for each skill name once.
checked_skill_names="|"
for skills_root in "$SHARED_SKILLS_SRC" "$CLAUDE_SKILLS_SRC"; do
  [ -d "$skills_root" ] || continue
  for skill_dir in "$skills_root"/*/; do
    [ -d "$skill_dir" ] || continue
    skill_name="$(basename "$skill_dir")"
    case "$checked_skill_names" in
      *"|$skill_name|"*)
        continue
        ;;
    esac
    check_projected_claude_skill "$skill_name"
    checked_skill_names="${checked_skill_names}${skill_name}|"
  done
done

# ── Repo-local skill projections ──────────────────────────────

header "Repo-local skill projections"

PROJECT_AGENTS_SKILLS_DIR="$DOTFILES_ROOT/.agents/skills"
PROJECT_CLAUDE_SKILLS_DIR="$DOTFILES_ROOT/.claude/skills"

check_projected_repo_skill() {
  target_dir="$1"
  label="$2"
  overlay_src="$3"
  projected_src="$4"
  skill_name="$5"

  if [ -n "$overlay_src" ] && [ -d "$overlay_src/$skill_name" ]; then
    check_symlink "$overlay_src/$skill_name" "$target_dir/$skill_name" "$label/$skill_name (overlay)"
  elif [ -d "$projected_src/$skill_name" ]; then
    check_symlink "$projected_src/$skill_name" "$target_dir/$skill_name" "$label/$skill_name (shared)"
  fi
}

for runtime_pair in "$PROJECT_AGENTS_SKILLS_DIR|.agents/skills||$PROJECTED_CODEX_SKILLS" "$PROJECT_CLAUDE_SKILLS_DIR|.claude/skills|$CLAUDE_SKILLS_SRC|$PROJECTED_CLAUDE_SKILLS"; do
  rt_dir="${runtime_pair%%|*}"
  rest="${runtime_pair#*|}"
  rt_label="${rest%%|*}"
  rest="${rest#*|}"
  rt_overlay="${rest%%|*}"
  rt_projected="${rest#*|}"

  [ -d "$rt_dir" ] || continue

  checked_repo_skills="|"
  for skills_root in "$SHARED_SKILLS_SRC" ${rt_overlay:+"$rt_overlay"}; do
    [ -d "$skills_root" ] || continue
    for skill_dir in "$skills_root"/*/; do
      [ -d "$skill_dir" ] || continue
      sname="$(basename "$skill_dir")"
      case "$checked_repo_skills" in
        *"|$sname|"*) continue ;;
      esac
      check_projected_repo_skill "$rt_dir" "$rt_label" "$rt_overlay" "$rt_projected" "$sname"
      checked_repo_skills="${checked_repo_skills}${sname}|"
    done
  done
done

# ── AI agents ──────────────────────────────────────────────────

header "AI agents"

MANAGED_AGENT_MARKER='# Managed by ~/.dotfiles/ai/install.sh. Edit source files instead.'
CLAUDE_AGENTS_SRC="$DOTFILES_ROOT/claude/agents"

# Assembled review agent
if [ -f "$CLAUDE_DIR/agents/review.md" ]; then
  if grep -Fq "$MANAGED_AGENT_MARKER" "$CLAUDE_DIR/agents/review.md" 2>/dev/null; then
    pass "~/.claude/agents/review.md (assembled)"
  else
    warn "~/.claude/agents/review.md exists but is not installer-managed"
  fi
else
  warn "~/.claude/agents/review.md is missing"
  info "Fix: dot"
fi

# Pi keeps a real profile-local agents directory; only managed files link to
# the generated shared agent tree. Custom agents and chains remain local.
if [ -d "$PI_RUNTIME_ROOT/agents" ]; then
  for profile in work personal; do
    profile_dir="$HOME/.pi/$profile"
    [ -d "$profile_dir" ] || continue
    agents_dir="$profile_dir/agents"
    if [ -L "$agents_dir" ]; then
      warn "~/.pi/$profile/agents is a symlink; expected a real profile-local directory"
      info "Fix: move the directory aside, then run dot"
    elif [ -d "$agents_dir" ]; then
      pass "~/.pi/$profile/agents is profile-local"
    else
      warn "~/.pi/$profile/agents is missing"
      info "Fix: dot"
      continue
    fi

    for agent_file in "$PI_RUNTIME_ROOT/agents"/*.md; do
      [ -f "$agent_file" ] || continue
      agent_name="$(basename "$agent_file")"
      check_symlink "$agent_file" "$agents_dir/$agent_name" "~/.pi/$profile/agents/$agent_name"
    done
  done
fi

# ── Pi extensions ──────────────────────────────────────────────

header "Pi extensions"

PI_EXTENSIONS_SRC="$DOTFILES_ROOT/pi/extensions"
if [ -d "$PI_EXTENSIONS_SRC" ]; then
  for profile in work personal; do
    profile_dir="$HOME/.pi/$profile"
    [ -d "$profile_dir" ] || continue
    for extension in "$PI_EXTENSIONS_SRC"/*.ts; do
      [ -f "$extension" ] || continue
      extension_name="$(basename "$extension")"
      check_symlink "$extension" "$profile_dir/extensions/$extension_name" "~/.pi/$profile/extensions/$extension_name"
    done
  done
fi

# Symlinked agent files
if [ -d "$CLAUDE_AGENTS_SRC" ]; then
  for agent_file in "$CLAUDE_AGENTS_SRC"/*.md; do
    [ -e "$agent_file" ] || continue
    case "$agent_file" in
      *.appendix.md) continue ;;
    esac
    agent_name="$(basename "$agent_file")"
    check_symlink "$agent_file" "$CLAUDE_DIR/agents/$agent_name" "~/.claude/agents/$agent_name"
  done
fi

# Claude Code settings
check_symlink "$DOTFILES_ROOT/claude/settings.json" "$CLAUDE_DIR/settings.json" "~/.claude/settings.json"

# ── Summary ────────────────────────────────────────────────────

printf "\n"
printf "%s passed, %s warnings, %s failures\n" "$_check_pass" "$_check_warnings" "$_check_failures"

if [ "$_check_failures" -gt 0 ]; then
  exit 1
fi

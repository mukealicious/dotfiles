#!/bin/sh
# One everyday Pi environment, using mise's managed Node runtime.
set -e

BIN_DIR="$(CDPATH='' cd -- "$(dirname "$0")" && pwd -P)"
DOTFILES_ROOT="$(CDPATH='' cd -- "$BIN_DIR/.." && pwd -P)"
PI_BIN="$HOME/.bun/bin/pi"

# Old panes may still export the retired profile. Explicit custom agent dirs
# remain supported for isolated testing and native Pi SDK/CLI workflows.
case "${PI_CODING_AGENT_DIR:-}" in
  ''|"$HOME/.pi/work"|"$HOME/.pi/personal")
    export PI_CODING_AGENT_DIR="$HOME/.pi/agent" ;;
esac
unset PI_DEFAULT_PROFILE PI_WRAPPER_PROFILE PI_DISPATCH_LIBRARY
# Everyday Pi is subscription-backed; never silently fall back to shell API keys.
unset OPENAI_API_KEY OPENAI_OP_REF
export GIT_EDITOR=true GIT_SEQUENCE_EDITOR=true GIT_MERGE_AUTOEDIT=no

if [ ! -x "$PI_BIN" ]; then
  echo "pi: expected binary at $PI_BIN" >&2
  exit 1
fi
if ! command -v mise >/dev/null 2>&1; then
  echo "pi: mise is required to run Pi with the managed Node runtime" >&2
  exit 1
fi
node_bin="$(mise which -C "$DOTFILES_ROOT" node 2>/dev/null || true)"
if [ -z "$node_bin" ] || [ ! -x "$node_bin" ]; then
  echo "pi: the mise-managed Node runtime is not installed; run mise/install.sh" >&2
  exit 1
fi
exec "$node_bin" "$PI_BIN" "$@"

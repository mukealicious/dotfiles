{
  "theme": "gruvbox-dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.5",
  "defaultThinkingLevel": "medium",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 5
  },
  "skills": [
    "~/.dotfiles/.ai-runtime/pi/skills",
    "~/skills/tldraw-offline"
  ],
  "packages": [
    "~/.dotfiles/pi/packages/pi-exa",
    "~/.dotfiles/pi/packages/pi-parallel",
    "~/.dotfiles/pi/packages/pi-openai-fast",
    "~/.dotfiles/pi/packages/pi-subagents",
    {
      "source": "npm:mitsupi@1.6.0",
      "extensions": [
        "extensions/answer.ts",
        "extensions/context.ts",
        "extensions/files.ts",
        "extensions/multi-edit.ts",
        "extensions/prompt-editor.ts",
        "extensions/todos.ts",
        "extensions/uv.ts",
        "extensions/whimsical.ts",
        "extensions/btw.ts",
        "extensions/review.ts"
      ],
      "skills": [
        "skills/apple-mail/SKILL.md",
        "skills/commit/SKILL.md",
        "skills/github/SKILL.md",
        "skills/google-workspace/SKILL.md",
        "skills/mermaid/SKILL.md",
        "skills/pi-share/SKILL.md",
        "skills/sentry/SKILL.md",
        "skills/summarize/SKILL.md",
        "skills/uv/SKILL.md"
      ],
      "prompts": [],
      "themes": []
    }
  ],
  "hideThinkingBlock": false
}
